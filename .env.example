PORT=3000

# PostgreSQL local VPS
DB_HOST=localhost
DB_PORT=5432
DB_USER=apiuser
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=apidb

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Email sender for forgot password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Batari App <your_email@gmail.com>

# WhatsApp sender for forgot password by phone
# Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=

# Twilio WhatsApp alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Mosquitto MQTT local VPS
MQTT_PROTOCOL=mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=batari-backend-server
MQTT_USERNAME=
MQTT_PASSWORD=

# BMS MQTT source
BMS_MQTT_PROTOCOL=mqtts
BMS_MQTT_HOST=your-bms-mqtt-host
BMS_MQTT_PORT=8883
BMS_MQTT_TOPIC=your/bms/topic
BMS_MQTT_CLIENT_ID=your-bms-mqtt-client-id
BMS_MQTT_USERNAME=your-bms-mqtt-username
BMS_MQTT_PASSWORD=your-bms-mqtt-password
BMS_MQTT_DEBUG=false
BMS_DEVICE_ID=BS26040012
BMS_TARGET_PLANT_NAME=Kantor Batari Energy
BMS_TARGET_DEVICE_ID=KANTOR_BATARI_BATTERY_001

# Persistent dummy data sender
MOCK_PLANT_ENABLED=true
MOCK_PLANT_ID=1
MOCK_PLANT_NAME=Plant Testing
MOCK_PLANT_INTERVAL_MS=300000

# Optional chart dummy fallback (response only, no DB insert)
MOCK_CHART_ENABLED=false
MOCK_CHART_POINTS_PER_DAY=180
