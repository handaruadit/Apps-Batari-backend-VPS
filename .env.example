PORT=3000

# PostgreSQL local VPS
DB_HOST=localhost
DB_PORT=5432
DB_USER=apiuser
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=apidb

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Mosquitto MQTT local VPS
MQTT_PROTOCOL=mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=batari-backend-server
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional mock plant sender
MOCK_PLANT_ENABLED=false
MOCK_PLANT_NAME=Plant Testing
MOCK_PLANT_INTERVAL_MS=300000
